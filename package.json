{
  "name": "landing-page-preflight-auditor",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Audits a landing page for tracking/analytics readiness before paid ad traffic.",
  "main": "server.js",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "vercel-build": "npm run build:client",
    "report": "node scripts/export-report.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
