# --- Core ---
PORT=8787
DEFAULT_TARGET_URL=https://neemans.com/products/the-luxe-loafers-tan
HEADLESS=true

# --- Gemini (optional: without it the report shows deterministic findings only) ---
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase (optional: without it runs are kept in memory) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_TABLE=audit_runs

# --- Deployment ---
# Only when the API is hosted separately from the UI (e.g. API on Render, UI on
# Vercel). Lock this to your UI's origin rather than leaving it open.
CORS_ORIGIN=https://your-ui.vercel.app

# Set in the CLIENT project (Vercel > Settings > Environment Variables) when the
# API is on a different domain. Leave unset when both live in one Vercel project.
# VITE_API_URL=https://preflight-auditor-api.onrender.com

# Set to "chrome" or "msedge" if a security policy blocks Playwright bundled browser.
# PLAYWRIGHT_CHANNEL=chrome
